set_global _enable_mmmc_by_default_flow      $CTE::mmmc_default
suppressMessage ENCEXT-2799
getVersion
win
set init_verilog {Single_Cycle_Top.v Instruction_Memory.v}
set init_top_cell Single_Cycle_Top
set init_lef_file {all.lef Single_Cycle_Core.lef sram_32x64_180nm.lef}
set init_pwr_net VDD
set init_gnd_net VSS
init_design
floorPlan -site tsm3site -s 800 800 60 60 60 60
loadIoFile Single_Cycle_SoC.io
addInst -inst core_top -cell Single_Cycle_Core -loc 150 200 -ori R0
addInst -inst data_sram -cell sram_32x64_180nm -loc 550 200 -ori R0
fit
zoomBox -949.07850 -390.75600 1888.46700 1010.05750
zoomBox -741.49200 -204.40350 1670.42200 986.28800
zoomBox -565.04350 -46.00400 1485.08350 966.08400
